# =============================================================================
# AEGIS Environment Variables
#
# Copy to .env and fill in values. NEVER commit .env to version control.
#
# ASSUMED-BREACH POSTURE: If this file is leaked, an attacker learns every
# threshold, model path, and endpoint. In production, source secrets from
# a vault (AWS Secrets Manager, HashiCorp Vault), not this file.
# =============================================================================

# --- Core Platform ---
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
AEGIS_DEBUG=false
AEGIS_LOG_LEVEL=INFO

# --- Upstream Model Provider ---
# Default: Ollama on host machine (use host.docker.internal inside Docker)
AEGIS_UPSTREAM_URL=http://localhost:11434
AEGIS_UPSTREAM_API_KEY=
AEGIS_MODEL=llama3.2:3b
# For OpenAI: AEGIS_UPSTREAM_URL=https://api.openai.com
# AEGIS_UPSTREAM_API_KEY=sk-your-upstream-api-key-here

# --- Gateway Authentication ---
AEGIS_API_KEY=aegis-dev-key

# --- Security ---
# HMAC secret for canary token generation — MUST change in production
AEGIS_CANARY_SECRET_KEY=change-me-in-production

# --- ML Models ---
# Set to "true" to skip DeBERTa/MiniLM loading (faster startup, regex-only)
AEGIS_SKIP_MODEL_LOAD=false

# --- Event Bus ---
AEGIS_EVENT_BUS_TYPE=memory
REDIS_URL=redis://localhost:6379/0

# --- Database ---
DATABASE_URL=postgresql+asyncpg://aegis:aegis_secret@localhost:5432/aegis

# --- L1 Barrier Layer ---
AEGIS_BARRIER_MAX_TOKENS_PER_REQUEST=128000
AEGIS_BARRIER_RATE_LIMIT_RPM=60
AEGIS_BARRIER_RATE_LIMIT_BURST=10
AEGIS_BARRIER_MAX_REQUEST_SIZE_BYTES=10485760
AEGIS_BARRIER_TLS_MIN_VERSION=1.3
AEGIS_BARRIER_MTLS_REQUIRED=false
AEGIS_BARRIER_IP_REPUTATION_ENABLED=true
AEGIS_BARRIER_SESSION_TIMEOUT_SECONDS=3600

# --- L2 Innate Detection ---
AEGIS_INNATE_BLOCK_THRESHOLD=0.85
AEGIS_INNATE_ALERT_THRESHOLD=0.50
AEGIS_INNATE_MAX_SCANNER_LATENCY_MS=5.0
AEGIS_INNATE_REGEX_PATTERN_FILE=data/patterns.json
AEGIS_INNATE_BLOCKLIST_FILE=data/blocklist.txt
AEGIS_INNATE_BLOOM_FILTER_FP_RATE=0.0001
AEGIS_INNATE_CANARY_TOKEN_ENABLED=true

# --- L3 Adaptive Analysis ---
AEGIS_ADAPTIVE_INJECTION_MODEL=ProtectAI/deberta-v3-base-prompt-injection-v2
AEGIS_ADAPTIVE_INJECTION_MODEL_ONNX=true
AEGIS_ADAPTIVE_EMBEDDING_MODEL=all-MiniLM-L6-v2
AEGIS_ADAPTIVE_SIMILARITY_THRESHOLD=0.85
AEGIS_ADAPTIVE_BEHAVIORAL_PSI_THRESHOLD=0.25
AEGIS_ADAPTIVE_MULTI_TURN_WINDOW=10
AEGIS_ADAPTIVE_MCAV_ANOMALY_THRESHOLD=0.7
AEGIS_ADAPTIVE_MCAV_THREAT_THRESHOLD=0.9
AEGIS_ADAPTIVE_MAX_LATENCY_MS=50.0

# --- L4 Immune Memory ---
AEGIS_MEMORY_FAISS_INDEX_TYPE=HNSW
AEGIS_MEMORY_FAISS_DIMENSION=384
AEGIS_MEMORY_FAISS_HNSW_M=32
AEGIS_MEMORY_FAISS_EF_SEARCH=64
AEGIS_MEMORY_ACUTE_MEMORY_DAYS=30
AEGIS_MEMORY_DORMANT_MEMORY_DAYS=180
AEGIS_MEMORY_SEED_THREATS_FILE=data/seed_threats.json
AEGIS_MEMORY_DP_EPSILON=3.0

# --- L5 Output Validation ---
AEGIS_OUTPUT_PII_REDACTION_THRESHOLD=0.7
AEGIS_OUTPUT_PII_ALERT_THRESHOLD=0.4
AEGIS_OUTPUT_STREAMING_WINDOW_SIZE=128
AEGIS_OUTPUT_STREAMING_WINDOW_OVERLAP=0.5
AEGIS_OUTPUT_TOXICITY_ENABLED=true
AEGIS_OUTPUT_HALLUCINATION_ENABLED=false
AEGIS_OUTPUT_LEAKAGE_NGRAM_SIZE=4
AEGIS_OUTPUT_LEAKAGE_OVERLAP_THRESHOLD=0.3

# --- L6 Policy Engine ---
AEGIS_POLICY_DEFAULT_THREAT_LEVEL=1
AEGIS_POLICY_BLUE_ESCALATION_MULTIPLIER=2.0
AEGIS_POLICY_BLOCK_THRESHOLD_REDUCTION_BLUE=0.10
AEGIS_POLICY_ENABLE_HUMAN_REVIEW_AT=3
AEGIS_POLICY_FAIL_CLOSED_AT=5
AEGIS_BLOCK_THRESHOLD=0.85
AEGIS_ALERT_THRESHOLD=0.50

# --- L7 Self-Healing ---
AEGIS_HEALING_CIRCUIT_BREAKER_THRESHOLD=0.50
AEGIS_HEALING_CIRCUIT_BREAKER_WINDOW_SECONDS=60
AEGIS_HEALING_COOLDOWN_SECONDS=30
AEGIS_HEALING_MAX_COOLDOWN_SECONDS=300
AEGIS_HEALING_PROBE_COUNT=5
AEGIS_HEALING_SANITIZATION_ENABLED=true
AEGIS_HEALING_QUARANTINE_THRESHOLD=3
# AEGIS_HEALING_FALLBACK_MODELS=["https://fallback1.example.com","https://fallback2.example.com"]

# --- L8 Federated Intelligence (production only) ---
AEGIS_FEDERATED_ENABLED=false
AEGIS_FEDERATED_AGGREGATION_URL=
AEGIS_FEDERATED_MODEL_UPDATE_INTERVAL_HOURS=6
AEGIS_FEDERATED_INDICATOR_SHARE_INTERVAL_MINUTES=15
AEGIS_FEDERATED_DP_EPSILON=3.0

# --- Supply Chain ---
AEGIS_SUPPLY_CHAIN_MODEL_BASE=/opt/models
